{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./"
  },
  "include": [
    "*.ts",
    "src/config.ts",
    "src/scraper.ts",
    "src/index.ts",
    "src/utils.ts"
  ],
  "exclude": ["node_modules"]
}
